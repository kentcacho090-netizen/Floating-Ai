# ============================================================
# Kent configuration
# Copy this file to .env and edit the values you need
# ============================================================

# ---------- Preferred: Local Ollama (free & private) ----------
# 1. Install from https://ollama.com
# 2. Pull a model:
#       ollama pull llama3.2          (good general model)
#       ollama pull llava             (for seeing the screen)
#
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---------- Optional: Gemini cloud (powerful fallback) ----------
# Only needed if you want cloud intelligence
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
