# ============================================================
# Kent configuration
# Copy this file to .env and edit the values you need
# ============================================================

# ---------- Preferred: Local Ollama (free & private) ----------
# Install from https://ollama.com then run:  ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# For vision (seeing the screen) use a vision model instead, e.g.:
# OLLAMA_MODEL=llava

# ---------- Optional: Gemini cloud (powerful fallback) ----------
# Only needed if you want cloud intelligence or vision without a local vision model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
